---
import { downloads, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="cta" id="download">
  <div class="inner fade-in">
    <img src="/logo.svg" width="64" height="64" alt="" class="mark" />
    <h2>{t.cta.title[0]}<br />{t.cta.title[1]}</h2>
    <p>{t.cta.text}</p>
    <div class="buttons">
      <a href={downloads.macos} class="btn btn-download">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.99 2.97 12.5 4.7 9.47C5.55 7.97 7.13 7.01 8.82 6.99C10.1 6.97 11.32 7.85 12.11 7.85C12.89 7.85 14.37 6.78 15.92 6.95C16.57 6.98 18.39 7.21 19.56 8.91C19.47 8.97 17.09 10.35 17.12 13.18C17.15 16.59 20.09 17.73 20.12 17.74C20.09 17.81 19.64 19.29 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
        {t.hero.download}
      </a>
      <a href={downloads.windows} class="windows">{t.hero.windows}</a>
    </div>
    <p class="note">{t.hero.note}</p>
  </div>
</section>

<style>
  .cta {
    background: var(--aubergine);
    color: #FFFFFF;
    padding: 6.5rem 2.5rem;
    text-align: center;
  }
  .inner { max-width: 40rem; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .mark { border-radius: 14px; box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.14); margin-bottom: 0.5rem; }
  h2 { font-size: clamp(2.25rem, 5vw, 3.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.08; }
  p { font-size: 1.0625rem; color: rgba(255, 255, 255, 0.72); line-height: 1.6; }
  .buttons { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 0.5rem; }
  .btn-download { background: var(--lyslilla); color: var(--aubergine); }
  .btn-download:hover { background: #E6CBFC; transform: translateY(-2px); }
  .windows {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 3px;
  }
  .windows:hover { color: #FFFFFF; }
  .note { font-size: 0.8125rem; color: rgba(255, 255, 255, 0.55); }

  :global(.dark) .cta { border-top: 1.5px solid rgba(188, 114, 247, 0.35); }
  :global(.dark) .btn-download { background: var(--lilla); }
  :global(.dark) .btn-download:hover { background: #CA8EF9; }
  @media (max-width: 640px) {
    .cta { padding: 4.5rem 1rem; }
  }
</style>
