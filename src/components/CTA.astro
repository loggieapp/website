---
import { downloads, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="section on-dark" id="download">
  <div class="wrap">
    <div class="inner fade-in">
      <h2>{t.cta.title[0]} {t.cta.title[1]}</h2>
      <p class="text">{t.cta.text}</p>
      <div class="buttons">
        <a href={downloads.macos} class="btn btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.99 2.97 12.5 4.7 9.47C5.55 7.97 7.13 7.01 8.82 6.99C10.1 6.97 11.32 7.85 12.11 7.85C12.89 7.85 14.37 6.78 15.92 6.95C16.57 6.98 18.39 7.21 19.56 8.91C19.47 8.97 17.09 10.35 17.12 13.18C17.15 16.59 20.09 17.73 20.12 17.74C20.09 17.81 19.64 19.29 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
          {t.hero.download}
        </a>
      </div>
      <p class="note">{t.hero.note[0]}<br />{t.hero.note[1]}</p>
    </div>
  </div>
</section>

<style>
  .inner { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  h2 { font-family: var(--display); font-size: clamp(2.25rem, 5vw, 4rem); text-wrap: balance; font-weight: 500; letter-spacing: -0.03em; line-height: 1.05; }
  .text { font-size: 1.0625rem; color: var(--muted); line-height: 1.6; }
  .buttons { display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: center; margin-top: 0.5rem; }
  .note { font-size: 0.8125rem; color: var(--muted); line-height: 1.6; }

</style>
