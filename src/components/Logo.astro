---
// The Loggie wordmark: "loggie" in Funnel Display with a lavender square as the full stop.
// Same proportions as Wordmark in the Mac app. Letters follow the text colour.
interface Props {
  size?: number;
}

const { size = 24 } = Astro.props;
---

<span class="logo" style={`--size: ${size}px`} role="img" aria-label="Loggie">
  <span aria-hidden="true">loggie</span><span class="dot" aria-hidden="true"></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: calc(var(--size) * 0.1);
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--size);
    letter-spacing: calc(var(--size) * -0.03);
    line-height: 1;
  }
  .dot {
    width: calc(var(--size) * 0.22);
    height: calc(var(--size) * 0.22);
    background: var(--lavender);
  }
</style>
