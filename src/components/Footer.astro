---
import Logo from './Logo.astro';
import { paths, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'no' : 'en';
---

<footer class="footer alt">
  <div class="inner">

    <div class="left">
      <a href={paths[lang]} class="brand" aria-label={t.nav.home}>
        <Logo height={22} />
      </a>
      <p class="tagline">{t.footer.tagline}</p>
    </div>

    <nav class="links" aria-label={t.footer.nav}>
      <a href="#how">{t.nav.how}</a>
      <a href="#features">{t.nav.features}</a>
      <a href="#download">{t.nav.download}</a>
      <a href={paths[other]} hreflang={ui[other].htmlLang} lang={ui[other].htmlLang}>{t.nav.otherLang}</a>
    </nav>

    <p class="copy">&copy; {new Date().getFullYear()} Loggie</p>

  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding: 2.5rem; }
  .inner { max-width: 64rem; margin: 0 auto; display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 3rem; }
  .left { display: flex; flex-direction: column; gap: 0.375rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; font-weight: 700; }
  .tagline { font-size: 0.8125rem; color: var(--muted); }
  .links { display: flex; gap: 1.75rem; flex-wrap: wrap; }
  .links a { font-size: 0.875rem; color: var(--muted); transition: color 0.15s; }
  .links a:hover { color: var(--text); }
  .copy { font-size: 0.8125rem; color: var(--muted); white-space: nowrap; }

  @media (max-width: 760px) {
    .footer { padding: 2.5rem 1rem; }
    .inner { grid-template-columns: 1fr; gap: 1.5rem; text-align: center; }
    .left { align-items: center; }
    .links { justify-content: center; gap: 1.25rem 1.75rem; }
  }
</style>
