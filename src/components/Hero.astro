---
import Logo from './Logo.astro';
import { downloads, paths, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'no' : 'en';
const focusBlocks = [
  { start: 4, width: 22, focus: true },
  { start: 28, width: 6, focus: false },
  { start: 37, width: 10, focus: false },
  { start: 52, width: 18, focus: true },
  { start: 73, width: 9, focus: false },
  { start: 85, width: 7, focus: false },
];
---

<header class="nav">
  <a href={paths[lang]} class="brand" aria-label={t.nav.home}>
    <Logo height={26} />
  </a>
  <nav>
    <a href="#how" class="nav-link">{t.nav.how}</a>
    <a href="#features" class="nav-link">{t.nav.features}</a>
    <a href={paths[other]} class="nav-link lang" hreflang={ui[other].htmlLang} lang={ui[other].htmlLang} aria-label={t.nav.otherLangLabel}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
      {t.nav.otherLang}
    </a>
    <button type="button" class="theme-toggle" data-to-dark={t.nav.toDark} data-to-light={t.nav.toLight} aria-label={t.nav.toDark}>
      <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg>
      <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
    </button>
    <a href="#download" class="nav-download">{t.nav.download}</a>
  </nav>
</header>

<section class="hero">
  <div class="heading-wrap fade-in">
    <h1>{t.hero.title[0]}<br class="br" />{' '}{t.hero.title[1]}</h1>
    <span class="hero-sticker" aria-hidden="true">{t.hero.sticker}</span>
  </div>

  <div class="hero-body fade-in">
    <p class="sub">{t.hero.sub}</p>
    <div class="cta-row">
      <a href={downloads.macos} class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.99 2.97 12.5 4.7 9.47C5.55 7.97 7.13 7.01 8.82 6.99C10.1 6.97 11.32 7.85 12.11 7.85C12.89 7.85 14.37 6.78 15.92 6.95C16.57 6.98 18.39 7.21 19.56 8.91C19.47 8.97 17.09 10.35 17.12 13.18C17.15 16.59 20.09 17.73 20.12 17.74C20.09 17.81 19.64 19.29 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
        {t.hero.download}
      </a>
      <a href={downloads.windows} class="text-link">{t.hero.windows}</a>
    </div>
    <p class="note">{t.hero.note}</p>
  </div>

  <div class="demo fade-in" aria-hidden="true">

    <!-- The menu bar menu -->
    <div class="card card-menu">
      <div class="working">
        <p class="working-eye">{t.demo.workingOn}</p>
        <div class="working-task">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5a2.1 2.1 0 013 3L8 18l-4 1 1-4z"/></svg>
          <span>{t.demo.task}</span>
        </div>
        <div class="working-row">
          <span class="timer">1:12:40</span>
          <span class="pause" title={t.demo.pause}>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><rect x="2" y="1.5" width="2.6" height="9" rx="1"/><rect x="7.4" y="1.5" width="2.6" height="9" rx="1"/></svg>
          </span>
        </div>
      </div>
      <p class="card-eye">{t.demo.projectsToday}</p>
      <ul class="projects">
        {t.demo.projects.map((p) => (
          <li>
            <div class="proj-head">
              <span class="dot" style={`background: var(--p${p.color})`}></span>
              <span class="proj-name">{p.name}</span>
              <span class="proj-time">{p.time}</span>
            </div>
            <div class="bar"><span style={`width: ${p.share}%; background: var(--p${p.color})`}></span></div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Asking Claude -->
    <div class="card card-chat">
      <p class="card-eye">{t.demo.ask}</p>
      <div class="chat">
        {t.demo.chat.map((m) =>
          m.q ? (
            <>
              <div class="chat-q">{m.q}</div>
              <div class="chat-tool">
                <img src="/logo.svg" width="14" height="14" alt="" />
                <code>{m.tool}</code>
              </div>
            </>
          ) : (
            <div class="chat-a">{m.a}</div>
          ),
        )}
      </div>
    </div>

    <!-- Focus time -->
    <div class="card card-focus">
      <p class="card-eye">{t.demo.focusToday}</p>
      <p class="focus-time">{t.demo.focusTime}</p>
      <p class="focus-sub">{t.demo.focusSub}</p>
      <div class="timeline">
        {focusBlocks.map((b) => (
          <span class:list={['block', { focus: b.focus }]} style={`left: ${b.start}%; width: ${b.width}%`}></span>
        ))}
      </div>
      <div class="axis">
        {t.demo.focusAxis.map((h) => <span>{h}</span>)}
      </div>
    </div>

  </div>
</section>

<script>
  // Light/dark switch in the nav. The theme itself is set in Base.astro.
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const label = () => {
    if (!toggle) return;
    const dark = document.documentElement.classList.contains('dark');
    toggle.setAttribute('aria-label', (dark ? toggle.dataset.toLight : toggle.dataset.toDark) ?? '');
  };
  toggle?.addEventListener('click', () => {
    const dark = document.documentElement.classList.contains('dark');
    (window as any).setTheme(dark ? 'light' : 'dark');
    label();
  });
  label();
</script>

<style>
  /* ── Nav ─────────────────────────────────────── */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 2.5rem;
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .brand { display: flex; align-items: center; gap: 0.625rem; font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.01em; }
  nav { display: flex; align-items: center; gap: 1.75rem; }
  .nav-link { font-size: 0.875rem; color: var(--muted); transition: color 0.15s; display: inline-flex; align-items: center; gap: 0.375rem; }
  .nav-link:hover { color: var(--text); }
  .nav-download {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.45rem 1.05rem;
    border-radius: 9999px;
    background: var(--btn-bg);
    color: var(--btn-text);
    transition: background 0.15s;
  }
  .nav-download:hover { background: var(--btn-hover); }
  .theme-toggle {
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--muted);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .theme-toggle:hover { color: var(--text); background: var(--bg-alt); }
  .theme-toggle .sun { display: none; }
  :global(.dark) .theme-toggle .sun { display: block; }
  :global(.dark) .theme-toggle .moon { display: none; }

  /* ── Hero ────────────────────────────────────── */
  .hero { padding-top: 4.5rem; text-align: center; overflow-x: clip; }
  .heading-wrap { position: relative; display: inline-block; padding: 0 2rem; margin-bottom: 1.75rem; }

  h1 {
    font-size: clamp(3.25rem, 7.5vw, 6.25rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .hero-sticker {
    position: absolute;
    top: 50%;
    left: 18%;
    transform: translateY(-50%) rotate(-3deg);
    background: var(--accent);
    color: var(--aubergine);
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(31, 2, 52, 0.14);
  }

  .hero-body { max-width: 42rem; margin: 0 auto; padding: 0 2rem; display: flex; flex-direction: column; align-items: center; gap: 1.375rem; }
  .sub { font-size: 1.125rem; color: var(--muted); line-height: 1.55; }
  .cta-row { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 0.25rem; }
  .note { font-size: 0.8125rem; color: var(--muted); }

  /* ── Demo cards ──────────────────────────────── */
  .demo {
    display: flex;
    align-items: flex-end;
    padding: 4.5rem 2rem 7rem;
    max-width: 64rem;
    margin: 0 auto;
  }
  .card {
    border-radius: 1.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex: 1;
    text-align: left;
    position: relative;
    background: var(--card);
    box-shadow: var(--shadow);
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.35s;
  }
  .card:hover { z-index: 10 !important; transform: translateY(-10px) rotate(0deg) !important; }
  .card-eye { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }

  /* Menu card */
  .card-menu { min-height: 340px; transform: rotate(-2.5deg) translateY(18px); z-index: 1; margin-right: -2.5rem; }
  .working {
    background: var(--aubergine);
    color: #FFFFFF;
    border: 1.5px solid var(--working-border);
    border-radius: 1rem;
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .working-eye { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--working-detail); }
  .working-task { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; font-weight: 600; }
  .working-task svg { color: var(--working-detail); flex-shrink: 0; }
  .working-row { display: flex; align-items: center; justify-content: space-between; }
  .timer { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .pause { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--working-detail); color: var(--aubergine); }

  .projects { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }
  .proj-head { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; }
  .dot { width: 9px; height: 9px; border-radius: 3px; flex-shrink: 0; }
  .proj-name { flex: 1; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .proj-time { color: var(--muted); font-variant-numeric: tabular-nums; }
  .bar { height: 5px; border-radius: 9999px; background: var(--track); margin-top: 0.35rem; overflow: hidden; }
  .bar span { display: block; height: 100%; border-radius: inherit; }

  /* Chat card */
  .card-chat { min-height: 400px; transform: rotate(1.5deg) translateY(-12px); z-index: 3; flex: 1.15; background: var(--mint); color: var(--aubergine); }
  .card-chat .card-eye { color: rgba(31, 2, 52, 0.55); }
  .chat { display: flex; flex-direction: column; gap: 0.5rem; }
  .chat-q { align-self: flex-end; background: var(--aubergine); color: #FFFFFF; font-size: 0.8125rem; line-height: 1.45; padding: 0.55rem 0.8rem; border-radius: 1rem 1rem 0.25rem 1rem; max-width: 88%; }
  .chat-tool { display: inline-flex; align-items: center; gap: 0.4rem; align-self: flex-start; font-size: 0.6875rem; padding: 0.2rem 0.6rem 0.2rem 0.3rem; border-radius: 9999px; background: rgba(255, 255, 255, 0.5); color: rgba(31, 2, 52, 0.7); }
  .chat-tool img { border-radius: 3px; }
  .chat-tool code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.6875rem; }
  .chat-a { background: rgba(255, 255, 255, 0.7); font-size: 0.8125rem; line-height: 1.5; padding: 0.55rem 0.8rem; border-radius: 1rem 1rem 1rem 0.25rem; max-width: 94%; }

  /* Focus card */
  .card-focus { min-height: 290px; transform: rotate(-1.5deg) translateY(22px); z-index: 2; margin-left: -2.5rem; background: var(--focus); color: var(--aubergine); }
  .card-focus .card-eye { color: rgba(31, 2, 52, 0.55); }
  .focus-time { font-size: 2.75rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; margin-top: 0.25rem; }
  .focus-sub { font-size: 0.8125rem; color: rgba(31, 2, 52, 0.7); }
  .timeline { position: relative; height: 34px; border-radius: 0.5rem; background: rgba(255, 255, 255, 0.45); margin-top: auto; }
  .block { position: absolute; top: 9px; bottom: 9px; border-radius: 4px; background: rgba(31, 2, 52, 0.2); }
  .block.focus { top: 4px; bottom: 4px; background: var(--aubergine); }
  .axis { display: flex; justify-content: space-between; font-size: 0.6875rem; color: rgba(31, 2, 52, 0.55); font-variant-numeric: tabular-nums; padding: 0 0.25rem; }

  :global(.dark) .card { box-shadow: var(--shadow), inset 0 0 0 1px var(--border); }
  :global(.dark) .timeline { background: rgba(31, 2, 52, 0.18); }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 860px) {
    .nav-link:not(.lang) { display: none; }
    .demo { padding: 4rem 1.5rem 5rem; }
    .card { padding: 1.25rem; }
    .card-menu { margin-right: -1rem; }
    .card-focus { margin-left: -1rem; }
  }
  @media (max-width: 640px) {
    .nav { padding: 0.875rem 1rem; }
    nav { gap: 0.625rem; }
    .hero { padding-top: 2.5rem; }
    .heading-wrap { padding: 0 1rem; margin-bottom: 1.25rem; }
    h1 { font-size: clamp(2.5rem, 11.5vw, 3.5rem); text-wrap: balance; }
    .br { display: none; }
    .hero-sticker { position: relative; top: auto; right: auto; display: inline-block; margin-top: 0.875rem; font-size: 0.875rem; transform: rotate(-3deg); }
    .hero-body { padding: 0 1rem; }
    .sub { font-size: 1rem; }
    .demo { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 1rem; gap: 1rem; padding: 2.5rem 0 3.5rem; align-items: stretch; scrollbar-width: none; }
    /* Empty edges plus the gap give a 1rem gutter at both ends */
    .demo::before, .demo::after { content: ''; width: 0; flex-shrink: 0; }
    .demo::-webkit-scrollbar { display: none; }
    .card { min-width: 80vw; flex-shrink: 0; scroll-snap-align: start; transform: none !important; margin: 0 !important; min-height: 0; }
  }
</style>
