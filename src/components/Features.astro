---
import { mcpTools, ui, type FeatureIcon, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

// Inner SVG markup for each feature icon (24×24, stroked)
const icons: Record<FeatureIcon, string> = {
  pen: '<path d="M16.5 3.5a2.1 2.1 0 013 3L8 18l-4 1 1-4z"/><path d="M14.5 5.5l3 3"/>',
  folder: '<path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>',
  focus: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="0.8" fill="currentColor"/>',
  moon: '<path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/>',
  sheet: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h16M4 15h16M10 3v18"/>',
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 10l3 2.5L7 15M12.5 15H17"/>',
  bell: '<path d="M6 16V11a6 6 0 1112 0v5l1.5 2h-15z"/><path d="M10 20.5a2.2 2.2 0 004 0"/>',
  toggle: '<rect x="2.5" y="6.5" width="19" height="11" rx="5.5"/><circle cx="16" cy="12" r="3"/>',
};
const iconColors = ['p5', 'p4', 'p1', 'p8', 'p2', 'p7', 'p5', 'p4'];
---

<section class="features alt" id="features">
  <div class="container">

    <div class="section-head fade-in">
      <p class="eyebrow">{t.features.eyebrow}</p>
      <h2 class="section-title">{t.features.title}</h2>
    </div>

    <div class="ai fade-in">
      <div class="ai-text">
        <span class="ai-tag">MCP</span>
        <h3>{t.features.ai.title}</h3>
        <p>{t.features.ai.text}</p>
      </div>
      <ul class="tools" aria-label="MCP">
        {mcpTools.map((tool) => <li><code>{tool}</code></li>)}
      </ul>
    </div>

    <div class="grid">
      {t.features.list.map((f, i) => (
        <div class="feat fade-in" style={`transition-delay: ${(i % 4) * 70}ms`}>
          <span class="icon" style={`--c: var(--${iconColors[i]})`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} />
          </span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .features { padding: 6.5rem 2.5rem; }
  .container { max-width: 64rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem; }
  .section-head { display: flex; flex-direction: column; gap: 0.625rem; }

  /* AI feature, full width */
  .ai {
    background: var(--aubergine);
    color: #FFFFFF;
    border: 1.5px solid var(--working-border);
    border-radius: 1.75rem;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .ai-text { display: flex; flex-direction: column; gap: 0.875rem; }
  .ai-tag {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.7rem;
    border-radius: 9999px;
    background: var(--working-detail);
    color: var(--aubergine);
  }
  .ai h3 { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; }
  .ai p { font-size: 1rem; line-height: 1.65; color: rgba(255, 255, 255, 0.75); }
  .tools { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tools li {
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid color-mix(in srgb, var(--working-detail) 35%, transparent);
  }
  .tools code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.8125rem; color: var(--working-detail); }

  /* Other features */
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .feat {
    background: var(--card);
    border-radius: 1.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    display: grid;
    place-items: center;
    color: var(--text);
    background: color-mix(in srgb, var(--c) 38%, transparent);
    margin-bottom: 0.5rem;
  }
  .feat h3 { font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; }
  .feat p { font-size: 0.875rem; color: var(--muted); line-height: 1.6; }

  :global(.dark) .icon { color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); }

  @media (max-width: 900px) {
    .ai { grid-template-columns: 1fr; }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .features { padding: 4.5rem 1rem; }
    .ai { padding: 1.75rem 1.5rem; border-radius: 1.5rem; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
