---
import { mcpTools, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

// One icon per feature, in the order of t.features.list (24×24, stroked)
const icons = [
  '<circle cx="12" cy="13.5" r="7.5"/><path d="M12 13.5V9.5M9.5 3h5"/>',
  '<path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>',
  '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="0.9" fill="currentColor"/>',
  '<path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/>',
  '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h16M4 15h16M10 3v18"/>',
  '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 10l3 2.5L7 15M12.5 15H17"/>',
  '<path d="M6 16V11a6 6 0 1112 0v5l1.5 2h-15z"/><path d="M10 20.5a2.2 2.2 0 004 0"/>',
  '<rect x="2.5" y="6.5" width="19" height="11" rx="5.5"/><circle cx="16" cy="12" r="3"/>',
];
---

<!-- Asking an AI tool about your day -->
<section class="section" id="ai">
  <div class="wrap">
    <div class="split">
    <div class="ai-text fade-in">
      <h2 class="section-title">{t.features.ai.title}</h2>
      <p class="section-sub">{t.features.ai.text}</p>
      <p class="tools">
        {mcpTools.map((tool, i) => <><code>{tool}</code>{i < mcpTools.length - 1 && <span aria-hidden="true"> · </span>}</>)}
      </p>
    </div>

    <div class="chat fade-in">
      <div class="thread" aria-hidden="true">
        {t.demo.chat.map((m) =>
          m.q ? (
            <>
              <div class="q">{m.q}</div>
              <div class="tool"><span class="sq"></span><code>{m.tool}</code></div>
            </>
          ) : (
            <div class="a">{m.a}</div>
          ),
        )}
      </div>
      <div class="box prompts">
        <p class="prompts-title">{t.how.promptsTitle}</p>
        <ul>
          {t.how.prompts.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
    </div>
  </div>
</section>

<!-- Everything else -->
<section class="section tint" id="features">
  <div class="wrap">
    <div class="section-head fade-in">
      <h2 class="section-title">{t.features.title}</h2>
      <p class="section-sub">{t.features.sub}</p>
    </div>

    <ul class="grid">
      {t.features.list.map((f, i) => (
        <li class="feat fade-in" style={`transition-delay: ${(i % 4) * 60}ms`}>
          <span class="icon box" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
          </span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Text on the left, the chat on the right, for a break from the centred sections */
  .split { display: grid; grid-template-columns: 1fr 1.1fr; gap: 5rem; align-items: center; }
  .ai-text { display: flex; flex-direction: column; gap: 1rem; }
  .ai-text .section-title { max-width: 14ch; }

  /* Chat card, with suggested questions in a quiet box underneath */
  .chat {
    background: var(--surface);
    box-shadow: var(--card-shadow);
    border-radius: var(--radius);
    padding: 0.5rem;
  }
  .thread { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem 1.25rem 1.5rem; }
  .q {
    align-self: flex-end;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    line-height: 1.45;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius);
    max-width: 85%;
  }
  .tool { display: inline-flex; align-items: center; gap: 0.4rem; align-self: flex-start; color: var(--muted); }
  .tool .sq { background: var(--lavender); width: 7px; height: 7px; }
  code { font-family: var(--mono); font-size: 0.75rem; }
  .a {
    background: var(--stone);
    font-size: 0.875rem;
    line-height: 1.5;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius);
    max-width: 92%;
    margin-bottom: 0.5rem;
  }
  .a:last-child { margin-bottom: 0; }

  .chat .prompts { padding: 1.25rem; background: var(--stone); }
  .prompts-title { font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; }
  .prompts ul { list-style: none; display: flex; flex-direction: column; gap: 0.375rem; }
  .prompts li { font-size: 0.875rem; }

  .tools { color: var(--muted); line-height: 1.9; margin-top: 0.75rem; }

  /* Feature grid: text only, no lines */
  .grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 3rem 2.5rem; }
  .feat { display: flex; flex-direction: column; gap: 0.5rem; }
  .icon {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .feat h3 { font-size: 1rem; font-weight: 500; }
  .feat p { font-size: 0.875rem; color: var(--muted); line-height: 1.6; }

  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; gap: 2.5rem; }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .thread { padding: 0.75rem 0.75rem 1rem; }
    .prompts { padding: 1rem; }
    .grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
