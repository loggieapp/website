---
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="privacy" id="privacy">
  <div class="container fade-in">
    <div class="text">
      <p class="eyebrow">{t.privacy.eyebrow}</p>
      <h2 class="section-title">{t.privacy.title}</h2>
      <p class="body">{t.privacy.text}</p>
    </div>
    <ul class="facts">
      {t.privacy.facts.map((fact) => (
        <li>
          <span class="check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
          </span>
          {fact}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .privacy { padding: 6rem 2.5rem; }
  .container {
    max-width: 64rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .text { display: flex; flex-direction: column; gap: 0.875rem; }
  .body { font-size: 1.0625rem; color: var(--muted); line-height: 1.65; margin-top: 0.25rem; }

  .facts {
    list-style: none;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--border);
    border-radius: 1.5rem;
    padding: 0.5rem 1.5rem;
  }
  .facts li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.95rem 0;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .facts li + li { border-top: 1px solid var(--border); }
  .check {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background: var(--mint);
    color: var(--aubergine);
  }

  @media (max-width: 860px) {
    .container { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 640px) {
    .privacy { padding: 4.5rem 1rem; }
  }
</style>
